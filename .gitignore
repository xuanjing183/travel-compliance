# Secrets (HC-07): only .env.example is committed
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# Local runtime data (regenerated by seed / demo reset)
var/
*.db
*.db-shm
*.db-wal
chroma/
uploads/

# Tooling
.idea/
.vscode/
.langgraph_api/
*.log

# Exception: spike/acceptance evidence logs under artifacts/ must be committed
!artifacts/**/*.log
