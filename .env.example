# Copy to .env only if you need to override defaults. Never commit .env (HC-07).
# Real model access requires AUTH-01. Demo and fake tests do not call any model.

# Required only when TRAVEL_DESK_LLM_MODE=real
#DASHSCOPE_API_KEY=sk-ws-YOUR_KEY_HERE
# Optional settings
TRAVEL_DESK_LLM_MODE=fake
TRAVEL_DESK_TEXT_MODEL=qwen3.8-max
TRAVEL_DESK_VISION_MODEL=qwen3.5-plus
TRAVEL_DESK_EMBED_MODEL=qwen3.7-text-embedding
TRAVEL_DESK_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEMO_TODAY=2026-10-20
